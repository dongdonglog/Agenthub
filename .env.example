# 运行环境：development | production
AGENTHUB_ENV=development

# 通道：off（只起骨架）| feishu
AGENTHUB_CHANNEL=off

# 健康检查与指标
AGENTHUB_HTTP_ADDR=127.0.0.1:8787

# 管理面（无内置登录，务必限制来源）
AGENTHUB_ADMIN_ADDR=127.0.0.1:8788
# 管理台访问令牌：设置后需 Bearer 或 /admin/login?token=... 登录；留空则不鉴权
AGENTHUB_ADMIN_TOKEN=

# 飞书事件回调监听（需被飞书访问；本地用隧道或反向代理）
AGENTHUB_WEBHOOK_ADDR=127.0.0.1:8789

# PostgreSQL：事实源，留空则只跑骨架
AGENTHUB_DB_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/agenthub?sslmode=disable
AGENTHUB_DB_MAX_CONNS=10

# 附件与产物目录
AGENTHUB_DATA_DIR=./data

# 飞书事件传输：websocket（长连接，默认，无需公网入口）| webhook（回调地址）
FEISHU_TRANSPORT=websocket
# 开放平台域名；Lark 海外用 https://open.larksuite.com
FEISHU_DOMAIN=https://open.feishu.cn

# 飞书自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人自身 open_id：用于识别群聊里是否 @了机器人
FEISHU_BOT_OPEN_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 白名单：open_id / chat_id，逗号分隔；留空表示拒绝所有人
FEISHU_ALLOWED_USERS=
FEISHU_ALLOWED_CHATS=
# 群聊是否必须 @机器人
FEISHU_REQUIRE_MENTION=true
# 免 @ 的群（逗号分隔），测试群常用；不影响其他群仍需 @
FEISHU_MENTION_FREE_CHATS=
# 卡片停止按钮：需要公网可达的 /feishu/card 回调地址，默认关闭
FEISHU_CARD_ACTION=false

# 模型（OpenAI 兼容接口；留空 API Key 时退回回显）
AGENTHUB_AGENT_PROVIDER=openai
AGENTHUB_AGENT_BASE_URL=https://api.openai.com/v1
AGENTHUB_AGENT_API_KEY=
AGENTHUB_AGENT_MODEL=gpt-4.1-mini
# 主模型连续失败后的兜底模型（可留空）
AGENTHUB_AGENT_FALLBACK_MODEL=
# 带图片的运行使用该模型（需支持视觉）；留空表示不启用图片理解
AGENTHUB_AGENT_VISION_MODEL=
# 追加在默认系统提示词之后
AGENTHUB_AGENT_SYSTEM_PROMPT=
# 技能目录，默认 <AA_DATA_DIR>/skills
AGENTHUB_AGENT_SKILLS_DIR=
AGENTHUB_AGENT_MAX_RUN_SECONDS=1800

# 日志
AGENTHUB_LOG_LEVEL=info
AGENTHUB_LOG_FORMAT=json

# docker compose 使用：PostgreSQL 密码（必填）
POSTGRES_PASSWORD=
