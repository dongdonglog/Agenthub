# 运行环境：development | production
AGENTHUB_ENV=development

# 通道：off（只起骨架）| feishu
AGENTHUB_CHANNEL=off
# 多实例单活入口：同一数据库上只有一个实例启动飞书长连接
AGENTHUB_HA_ENABLED=false

# 健康检查与指标
AGENTHUB_HTTP_ADDR=127.0.0.1:8787

# 管理面（无内置登录，务必限制来源）
AGENTHUB_ADMIN_ADDR=127.0.0.1:8788
# 管理台访问令牌：设置后需 Bearer 或 /admin/login?token=... 登录；留空则不鉴权
AGENTHUB_ADMIN_TOKEN=
# 可选：操作员/只读令牌（写操作需 operator 或 admin）
AGENTHUB_ADMIN_OPERATOR_TOKEN=
AGENTHUB_ADMIN_VIEW_TOKEN=

# 飞书事件回调监听（需被飞书访问；本地用隧道或反向代理）
AGENTHUB_WEBHOOK_ADDR=127.0.0.1:8789

# PostgreSQL：事实源，留空则只跑骨架
AGENTHUB_DB_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/agenthub?sslmode=disable
AGENTHUB_DB_MAX_CONNS=10

# 附件与产物目录
AGENTHUB_DATA_DIR=./data
# 跨会话并发运行上限（<=0 时回落到 4）
AGENTHUB_MAX_CONCURRENT_RUNS=4
# 每会话每分钟消息上限；0 关闭
AGENTHUB_RATE_LIMIT_PER_MIN=0
# 历史数据与工作区保留天数；0 关闭清理
AGENTHUB_RETENTION_DAYS=90
# 排队消息最长等待时间；超过后跳过并提示重新发送（0 关闭）
AGENTHUB_QUEUE_TTL_SECONDS=21600
# 投递租约；应大于单次通道调用耗时，默认 120 秒
AGENTHUB_DELIVERY_LEASE_SECONDS=120
# 跨会话共享出站消息速率；0 不限
AGENTHUB_OUTBOUND_QPS=0
# 交付物限制：单文件 20MB、单次 10 个、总量 50MB
AGENTHUB_ARTIFACT_MAX_BYTES=20971520
AGENTHUB_ARTIFACT_MAX_COUNT=10
AGENTHUB_ARTIFACT_MAX_TOTAL=52428800

# 飞书事件传输：websocket（长连接，默认，无需公网入口）| webhook（回调地址）
FEISHU_TRANSPORT=websocket
# 开放平台域名；Lark 海外用 https://open.larksuite.com
FEISHU_DOMAIN=https://open.feishu.cn

# 飞书自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人自身 open_id：用于识别群聊里是否 @了机器人
FEISHU_BOT_OPEN_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 白名单：open_id / chat_id，逗号分隔；留空表示拒绝所有人
FEISHU_ALLOWED_USERS=
FEISHU_ALLOWED_CHATS=
# 允许引用机器人消息干预他人会话的管理员 open_id，逗号分隔
FEISHU_ADMIN_OPEN_IDS=
# 群聊是否必须 @机器人
FEISHU_REQUIRE_MENTION=true
# 免 @ 的群（逗号分隔），测试群常用；不影响其他群仍需 @
FEISHU_MENTION_FREE_CHATS=
# 卡片停止按钮：需要公网可达的 /feishu/card 回调地址，默认关闭
FEISHU_CARD_ACTION=false

# 模型（OpenAI 兼容接口；留空 API Key 时退回回显）
AGENTHUB_AGENT_PROVIDER=openai
AGENTHUB_AGENT_BASE_URL=https://api.openai.com/v1
AGENTHUB_AGENT_API_KEY=
AGENTHUB_AGENT_MODEL=gpt-4.1-mini
# 主模型连续失败后的兜底模型（可留空）
AGENTHUB_AGENT_FALLBACK_MODEL=
# 带图片的运行使用该模型（需支持视觉）；留空表示不启用图片理解
AGENTHUB_AGENT_VISION_MODEL=
# 追加在默认系统提示词之后
AGENTHUB_AGENT_SYSTEM_PROMPT=
# 技能目录，默认 <AA_DATA_DIR>/skills
AGENTHUB_AGENT_SKILLS_DIR=
AGENTHUB_AGENT_MAX_RUN_SECONDS=1800

# ── AIOps / Alertmanager 告警接入 ──
AGENTHUB_AIOPS_ENABLED=false
AGENTHUB_AIOPS_TOKEN=
AGENTHUB_AIOPS_CHAT_ID=
AGENTHUB_AIOPS_RUNBOOK_DIR=
# 服务目录：owner/team/runbook/dashboard/repo/namespace
AGENTHUB_SERVICE_CATALOG=
AGENTHUB_AIOPS_MAX_ALERTS=20
# 每个告警来源每分钟上限；0 表示不限制
AGENTHUB_AIOPS_RATE_PER_MIN=120
# 按来源覆盖 token，JSON：{"grafana":"...","pagerduty":"..."}
AGENTHUB_AIOPS_SOURCE_TOKENS={}
# MCP 工具网关的上游 MCP server（JSON 数组）；read_only=false 的上游默认跳过
AGENTHUB_MCP_UPSTREAMS=[]
# 或用文件保存上游配置（优先于环境变量）
AGENTHUB_MCP_UPSTREAMS_FILE=
# 显式允许写工具；默认 false，只暴露只读上游
AGENTHUB_MCP_ALLOW_WRITE=false
# 可选工具 allow/deny（逗号分隔）与审计文件
AGENTHUB_MCP_TOOL_ALLOW=
AGENTHUB_MCP_TOOL_DENY=
AGENTHUB_MCP_AUDIT_FILE=/data/mcp-audit.jsonl
# 技术支持工单入口
AGENTHUB_SUPPORT_ENABLED=false
AGENTHUB_SUPPORT_TOKEN=
AGENTHUB_SUPPORT_CHAT_ID=
AGENTHUB_SUPPORT_EMPLOYEE_ID=tech-support
# 技术支持知识库目录（Markdown）
AGENTHUB_KNOWLEDGE_DIR=
# 只检索该团队子目录与全局文档；留空表示不限制
AGENTHUB_SUPPORT_TEAM=
# 只读观测工具；配置后自动注册 ops MCP 给 pi
AGENTHUB_PROMETHEUS_URL=
AGENTHUB_PROMETHEUS_TOKEN=
AGENTHUB_PROMETHEUS_USER=
AGENTHUB_PROMETHEUS_PASSWORD=
AGENTHUB_LOKI_URL=
AGENTHUB_LOKI_TOKEN=
AGENTHUB_LOKI_USER=
AGENTHUB_LOKI_PASSWORD=
AGENTHUB_TEMPO_URL=
AGENTHUB_TEMPO_TOKEN=
AGENTHUB_TEMPO_USER=
AGENTHUB_TEMPO_PASSWORD=
# K8s 只读工具：需要容器内 kubeconfig/ServiceAccount
AGENTHUB_K8S_ENABLED=false
AGENTHUB_KUBECTL_BIN=kubectl
# 受控动作允许的 namespace，逗号分隔；留空表示禁止执行任何动作
AGENTHUB_K8S_NAMESPACES=
# 留空时使用 agentd 同目录的 agenthub-ops-mcp
AGENTHUB_OPS_MCP_BIN=
# 可选：pi-package 目录；留空时查找 agentd 同目录/当前目录
AGENTHUB_PI_PACKAGE=

# 日志
AGENTHUB_LOG_LEVEL=info
AGENTHUB_LOG_FORMAT=json

# docker compose 使用：PostgreSQL 密码（必填）
POSTGRES_PASSWORD=

# ── 钉钉机器人（AGENTHUB_CHANNEL=dingtalk）──
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REQUIRE_MENTION=true
DINGTALK_ALLOWED_USERS=
DINGTALK_ALLOWED_CHATS=
# 群内免用户白名单；仍受 DINGTALK_ALLOWED_CHATS 限制
DINGTALK_GROUP_OPEN=false
DINGTALK_BOT_NAME=

# ── pi 运行时（镜像内置 Node 22 + pi 1.4.0）──
PI_BIN=pi
PI_TOOLS=read,bash,edit,write,grep,find,ls,tool_search
PI_ISOLATION=process_group
PI_TIMEOUT_SECONDS=600
# PI_AGENT_DIR=./data/pi/agent
# PI_SESSION_DIR=./data/pi/sessions
# PI_WORKSPACE_DIR=./data/pi/workspaces
