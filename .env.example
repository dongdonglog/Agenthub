# 运行环境：development | production
AGENTHUB_ENV=development

# 通道：off（只起骨架）| feishu
AGENTHUB_CHANNEL=off

# 健康检查与指标
AGENTHUB_HTTP_ADDR=127.0.0.1:8787

# 管理面（无内置登录，务必限制来源）
AGENTHUB_ADMIN_ADDR=127.0.0.1:8788

# 飞书事件回调监听（需被飞书访问；本地用隧道或反向代理）
AGENTHUB_WEBHOOK_ADDR=127.0.0.1:8789

# PostgreSQL：事实源，留空则只跑骨架
AGENTHUB_DB_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/agenthub?sslmode=disable
AGENTHUB_DB_MAX_CONNS=10

# 附件与产物目录
AGENTHUB_DATA_DIR=./data

# 飞书自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人自身 open_id：用于识别群聊里是否 @了机器人
FEISHU_BOT_OPEN_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 白名单：open_id / chat_id，逗号分隔；留空表示拒绝所有人
FEISHU_ALLOWED_USERS=
FEISHU_ALLOWED_CHATS=
# 群聊是否必须 @机器人
FEISHU_REQUIRE_MENTION=true

# 模型
AGENTHUB_AGENT_PROVIDER=openai
AGENTHUB_AGENT_MODEL=gpt-4.1-mini
AGENTHUB_AGENT_MAX_RUN_SECONDS=1800

# 日志
AGENTHUB_LOG_LEVEL=info
AGENTHUB_LOG_FORMAT=json
